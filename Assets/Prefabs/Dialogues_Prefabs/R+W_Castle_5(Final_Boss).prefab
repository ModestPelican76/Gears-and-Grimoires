    Snaill","OptionUIDs":null,"SpeechUID":0,"TimeUntilAdvance":0,"Volume":0},{"Connections":[{"__type":"EditableSpeechConnection:#DialogueEditor","Conditions":[],"NodeUID":6}],"EditorInfo":{"isRoot":false,"xPos":504,"yPos":380},"ID":4,"ParamActions":[],"TMPFontGUID":null,"Text":"So,
